# Normalize line endings across Windows and Linux checkouts.
* text=auto eol=lf

# Windows entry points keep CRLF so they run cleanly in PowerShell.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary artefacts must never be converted.
*.pptx binary
*.docx binary
*.xlsx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.sqlite3 binary
